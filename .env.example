# Gateway
GATEWAY_PORT=8080

# Repository backend for user-service and crud-service: postgres (default) or memory.
# Set to memory to run those services with no external database.
REPO_BACKEND=postgres

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
AUTH_DB=auth_db
USER_DB=user_db
CRUD_DB=crud_db

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ISSUER=ktor-microservices-kit
JWT_EXPIRATION_MS=3600000

# Auth
BCRYPT_COST=12

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
